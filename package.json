{
  "name": "immersive-farm-simulator-3d",
  "private": true,
  "version": "0.1.0",
  "description": "Immersive Farm Simulator 3D - Simulador de granja 3D profesional (Three.js + R3F + Rapier)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "wrangler dev & vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "deploy:setup": "pwsh scripts/setup-cloudflare.ps1",
    "deploy:api": "wrangler deploy",
    "deploy:pages": "wrangler pages deploy dist",
    "deploy": "npm run build && npm run deploy:api && npm run deploy:pages",
    "db:init": "wrangler d1 migrations apply harvest_valley_db"
  },
  "dependencies": {
    "@babylonjs/core": "^9.21.2",
    "@babylonjs/loaders": "^9.21.2",
    "@react-spring/web": "^10.1.2",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.0.5",
    "@react-three/rapier": "^2.2.0",
    "postprocessing": "^6.39.4",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240923.0",
    "@types/node": "^26.2.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "~5.9.3",
    "vite": "^8.2.1"
  }
}
